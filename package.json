{
  "name": "misub",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && npm start",
    "build": "vite build",
    "build:server": "node deploy/dmit/build.mjs",
    "start": "node deploy/dmit/runtime.mjs",
    "test:node": "npm run build:server && node --test tests/node/*.test.mjs",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "format": "prettier --write \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\""
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "js-yaml": "^4.1.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.0.11",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "terser": "^5.48.0",
    "vite": "^7.1.2",
    "vitest": "^4.0.16"
  }
}
