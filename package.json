{
  "name": "misub",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && npm start",
    "build": "vite build",
    "build:server": "node deploy/dmit/build.mjs",
    "start": "node deploy/dmit/runtime.mjs",
    "test:node": "npm run build:server && node --test tests/node/*.test.mjs",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "format": "prettier --write \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\""
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "undici": "^8.12.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.4",
      "editorconfig": {
        "minimatch": "^11.0.5"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "~2.4.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "terser": "^5.48.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
